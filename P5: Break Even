# Failure case 1: tiny image, k too large -> good reconstruction, MORE storage
m2, n2, k2 = 20, 20, 15
rng = np.random.default_rng(0)
small = rng.random((m2, n2))
Us, Ss, Vts = my_svd(small)                     # local names: don't touch U, S, Vt
approx = rank_k(Us, Ss, Vts, k2)
rel_err = np.linalg.norm(small - approx) / np.linalg.norm(small)

orig2 = m2 * n2
svd2 = k2 * (m2 + n2 + 1)
print(f"Image {m2}x{n2}, k={k2}")
print("Original storage:", orig2, "| SVD storage:", svd2)
print(f"Relative error: {rel_err:.4f}")
print(f"Storage saving: {(1 - svd2 / orig2) * 100:.2f}%")
print("Status:", "BENEFICIAL" if svd2 < orig2 else "NOT BENEFICIAL (SVD stores more than the original)")



