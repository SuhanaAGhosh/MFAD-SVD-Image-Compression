# Break-even for our image (no input(): values come from A)
k_demo = 50
original = m * n
svd_storage = k_demo * (m + n + 1)
threshold = original / (m + n + 1)
largest_k = (original - 1) // (m + n + 1)    # largest integer k with k(m+n+1) < mn

print("Formula: beneficial only if k*(m+n+1) < m*n")
print(f"Image: {m} x {n}, k = {k_demo}")
print("Original storage:", original)
print("SVD storage:", svd_storage)
print(f"Break-even k: {threshold:.2f}")
print("Largest beneficial k:", largest_k)
print(f"Compression ratio: {original / svd_storage:.2f}x")
print(f"Storage saving: {(1 - svd_storage / original) * 100:.2f}%")
print("Status:", "BENEFICIAL" if svd_storage < original else "NOT BENEFICIAL")

ks_be = np.arange(1, 513)
plt.plot(ks_be, ks_be * (m + n + 1) / (m * n))
plt.axhline(1, color="r", ls="--", label="original size")
plt.axvline(threshold, color="g", ls="--", label=f"break-even k = {threshold:.0f}")
plt.xlabel("k"); plt.ylabel("compressed / original storage"); plt.legend(); plt.show()

